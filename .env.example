# Copy this file to .env and fill in the values. Never commit .env.

# Which LLM plays the teacher: gemini | openrouter | ollama | anthropic
LLM_PROVIDER=gemini
# Model name for the chosen provider (kept here, not in code), e.g. gemini-3.8-flash
LLM_MODEL=

GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=
